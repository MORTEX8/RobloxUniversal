-- TS-Silent library (exact provided silent-aim logic, configurable from loader)
-- Amongushook parity: config.MagicBullet ā€” when true, uses straight look-at prediction (no ProjectileDrop correction on aim vector).
-- Loader passes: Enabled, HitPart, FovRadius, MagicBullet (optional, default false)
-- Returns a function: init(config)

return function(config)
    config = config or {}

    local function esc(str)
        return tostring(str):gsub("\\", "\\\\"):gsub("\"", "\\\"")
    end

    local enabled = (config.Enabled == nil) and true or config.Enabled
    local hitPart = config.HitPart or "Head"
    local fovRadius = config.FovRadius or 600
    local magicBullet = (config.MagicBullet == nil) and false or not not config.MagicBullet

    local actorScript = string.format([[
        -- // Variables 
        local camera = workspace.CurrentCamera;
        local runService = game:GetService("RunService");

        local silentAim = {
            Enabled = %s,
            HitPart = "%s", -- { "Head", "Torso" }
            MagicBullet = %s,
            Fov = {
                Radius = %s
            },

            PlayersVelocity = { -- Don't touch
                Position = { },
                Time = { }
            }
        };

        local createProjectile;
        local players = { };

        for i,v in getgc() do 
            if typeof(v) == "function" and not iscclosure(v) then 
                if debug.getconstants(v)[1] == "ProjectileSpeed" and string.match(debug.info(v, "s"), "RangedWeaponClient") then
                    createProjectile = v;
                elseif debug.info(v, "n") == "updatePlayers" and string.match(debug.info(v, "s"), "PlayerClient") then 
                    players = debug.getupvalue(v, 1); 
                end;
            end;
        end;

        -- // Functions
        local function getclosestPlayer()
            local closest, closestIndex, closestdistance = nil, 0, silentAim.Fov.Radius;

            for index, player in players do 
                if not player.model or player.sleeping then 
                    continue;
                end;

                local hitPart = player.model:FindFirstChild(silentAim.HitPart);
                if not hitPart then 
                    continue;
                end;

                local screenPosition = camera:WorldToViewportPoint(hitPart.Position);
                if screenPosition.Z <= 0 then 
                    continue;
                end;

                local distance = (camera.ViewportSize/2 - Vector2.new(screenPosition.X, screenPosition.Y)).Magnitude;
                if distance < closestdistance then 
                    closestdistance = distance;
                    closest = hitPart;
                    closestIndex = index;
                end;
            end;

            return closest, closestIndex;
        end;

        local function calculateTime(from, to, muzzleVelocity)
            local distance = (to - from).Magnitude;
            local time = distance / muzzleVelocity;

            return time;
        end;

        -- // Silent Aim
        local oldCreateProjectile; oldCreateProjectile = hookfunction(createProjectile, function(cFrame, weaponInfo, isLocal, p63, p64)

            if isLocal and silentAim.Enabled then 
                local hitPart, index = getclosestPlayer();
                if hitPart then 
                    local time = calculateTime(cFrame.Position, hitPart.Position, weaponInfo.ProjectileSpeed);
                    local playerVelocity = (silentAim.PlayersVelocity.Position[index][15] and (silentAim.PlayersVelocity.Position[index][15] - silentAim.PlayersVelocity.Position[index][1]) / (silentAim.PlayersVelocity.Time[15] - silentAim.PlayersVelocity.Time[1])) or Vector3.zero;
                    local prediction = hitPart.Position + (playerVelocity * time); 
                    time = calculateTime(cFrame.Position, prediction, weaponInfo.ProjectileSpeed);

                    if silentAim.MagicBullet then
                        -- Magic bullet (Amongushook silentAim_magicBullet): direct aim at prediction, no drop term on look vector
                        cFrame = CFrame.new(cFrame.Position, prediction);
                    else
                        cFrame = CFrame.new(cFrame.Position, prediction - Vector3.yAxis * (-weaponInfo.ProjectileDrop ^ (time * weaponInfo.ProjectileDrop) + 1));
                    end;
                end;    
            end;

            return oldCreateProjectile(cFrame, weaponInfo, isLocal, p63, p64);
        end);


        -- // shitty loops
        runService.Heartbeat:Connect(function() 
            for index, player in players do
                if not player.model or player.sleeping then 
                    continue;
                end;

                silentAim.PlayersVelocity.Position[index] = silentAim.PlayersVelocity.Position[index] or { };
                table.insert(silentAim.PlayersVelocity.Position[index], 1, player.model.Torso.Position);
                table.remove(silentAim.PlayersVelocity.Position[index], 16);
            end;

            table.insert(silentAim.PlayersVelocity.Time, 1, tick());
            table.remove(silentAim.PlayersVelocity.Time, 16);
        end);
    ]], tostring(enabled), esc(hitPart), tostring(magicBullet), tostring(fovRadius))

    run_on_actor(getactors()[1], actorScript)
end
